# Copy to .env and fill in. .env is git-ignored and must never be committed.

# Anthropic API key for the AI investigation agent (claude-opus-5).
# If unset, the system falls back to a deterministic engine-only investigation.
ANTHROPIC_API_KEY=

# SQLite database URL (Postgres-compatible URL also works).
DATABASE_URL=sqlite:///./vigil.db

# Model id for the investigation agent.
VIGIL_MODEL=claude-opus-5
