# Copy to .env for local dev. .env is git-ignored and must never be committed.
# On a hosting platform, set these as environment variables instead of a file.
#
# All values are OPTIONAL - with none set, Vigil runs the deterministic
# engine-only investigation (the official demo fallback).

# --- Live investigation provider (optional) --------------------------------
# Provider precedence: Gemini if GEMINI_API_KEY is set, else Anthropic if
# ANTHROPIC_API_KEY is set, else engine-only fallback.

# Google Gemini (free tier: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Anthropic (optional alternative provider)
ANTHROPIC_API_KEY=
VIGIL_MODEL=claude-opus-5

# --- Storage --------------------------------------------------------------
# SQLite by default; a Postgres-compatible URL also works.
DATABASE_URL=sqlite:///./vigil.db
